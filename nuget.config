<?xml version="1.0" encoding="utf-8"?>
<!--
  One package source, and every package ID mapped to it. <clear/> drops sources from the
  machine-wide config, so a build doesn't depend on who runs it; source mapping blocks
  dependency confusion (a same-named package from another feed).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
