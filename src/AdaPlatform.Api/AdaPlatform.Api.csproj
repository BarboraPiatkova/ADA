<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local secrets (e.g. Map:MapyComApiKey) live in the user-secrets store, never in the repo. -->
    <UserSecretsId>56b3f5a4-8d95-4252-9c70-0155e48c670f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaPlatform.Infrastructure\AdaPlatform.Infrastructure.csproj" />
    <!--
      Both migration sets ship with the API so one build can run on either engine;
      Database:Provider picks which one is applied at runtime.
    -->
    <ProjectReference Include="..\AdaPlatform.Migrations.Postgres\AdaPlatform.Migrations.Postgres.csproj" />
    <ProjectReference Include="..\AdaPlatform.Migrations.SqlServer\AdaPlatform.Migrations.SqlServer.csproj" />
  </ItemGroup>

</Project>
